# ===== PROVIDER SELECTION =====
STT_PROVIDER=elevenlabs
LLM_PROVIDER=mistral

# ===== API KEYS =====
ELEVENLABS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# ===== STT MODEL (optional) =====
ELEVENLABS_STT_MODEL=scribe_v2_realtime
MISTRAL_STT_MODEL=voxtral-mini-transcribe-realtime-2602

# ===== LLM MODEL OVERRIDES (optional) =====
GEMINI_LLM_MODEL=gemini-2.5-flash
MISTRAL_LLM_MODEL=mistral-large-latest

# ===== LLM GENERATION (optional) =====
# LLM_TEMPERATURE=0.7
# LLM_MAX_OUTPUT_TOKENS=256

# ===== CONVERSATION (optional) =====
# MAX_CONVERSATION_HISTORY=20
KNOWLEDGE_FILE_PATH="data/knowledge.yaml"

# ===== PUBLIC URL =====
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.dev

